[node name="AddrRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="AddrLabel" type="Label" parent="Panel/Margin/VBox/AddrRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "加入地址"

[node name="AddressEdit" type="LineEdit" parent="Panel/Margin/VBox/AddrRow"]
unique_name_in_owner = true
layout_mode = 2
