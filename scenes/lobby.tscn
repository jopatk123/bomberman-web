[node name="BtnRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HostBtn" type="Button" parent="Panel/Margin/VBox/BtnRow"]
unique_name_in_owner = true
layout_mode = 2
